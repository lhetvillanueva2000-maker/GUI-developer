# Netlify reads this file from inside the published directory, which means
# it applies however the site was deployed - dragged onto the dashboard as a
# folder, or built from the repository. That is why the headers live here
# rather than only in netlify.toml, which is read from the *base* directory
# and so is missed entirely by a drag-and-drop deploy of this folder.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src https://api.github.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# The page is one file and it carries the version in it, so it must not be
# served from a stale cache after a redeploy.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
